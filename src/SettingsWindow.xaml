<Window x:Class="CodexUsage.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Usage · Settings" Width="510" Height="730"
        MinWidth="390" MinHeight="430" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="Black"/>
        <SolidColorBrush x:Key="Ink" Color="White"/>
        <SolidColorBrush x:Key="Muted" Color="#BDBDBD"/>
        <SolidColorBrush x:Key="Line" Color="#777777"/>
        <Style x:Key="FocusRing" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" Stroke="{DynamicResource Ink}" StrokeThickness="1" StrokeDashArray="2 2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.7"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Ink}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Surface}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center" BorderBrush="{DynamicResource Ink}" BorderThickness="1">
                                <Path x:Name="Check" Visibility="Collapsed" Data="M 3,7 L 6,10 L 12,3" Stroke="{DynamicResource Ink}" StrokeThickness="2"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="3" Margin="8,0" Background="{DynamicResource Line}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Width="16" Height="22"><Thumb.Template><ControlTemplate><Border Background="{DynamicResource Ink}" BorderBrush="{DynamicResource Surface}" BorderThickness="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate><Border Background="{DynamicResource Line}" Margin="3,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource Surface}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="24,22,24,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Dock, appearance and startup." Style="{StaticResource Hint}"/>
            </StackPanel>
            <Image x:Name="BrandIcon" Grid.Column="1" Width="40" Height="40" Margin="16,0,0,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,16" Focusable="False">
            <StackPanel>
                <TextBlock Text="Dock" Style="{StaticResource Section}"/>
                <WrapPanel x:Name="DockOptions">
                    <RadioButton Content="Floating" GroupName="Dock" Tag="Bebas" Checked="DockChanged"/>
                    <RadioButton Content="Left" GroupName="Dock" Tag="Kiri" Checked="DockChanged"/>
                    <RadioButton Content="Right" GroupName="Dock" Tag="Kanan" Checked="DockChanged"/>
                    <RadioButton Content="Top" GroupName="Dock" Tag="Atas" Checked="DockChanged"/>
                    <RadioButton Content="Bottom" GroupName="Dock" Tag="Bawah" Checked="DockChanged"/>
                </WrapPanel>
                <TextBlock Text="Drag the dock along its edge. Hover to reveal usage." Style="{StaticResource Hint}"/>
                <CheckBox x:Name="TopmostToggle" Content="Always on top" Margin="0,10,0,0" Click="TopmostChanged"/>
                <TextBlock x:Name="TopmostHint" Style="{StaticResource Hint}" Margin="28,0,0,0"/>

                <Border Height="1" Background="{DynamicResource Line}" Margin="0,22,0,20"/>
                <TextBlock Text="Appearance" Style="{StaticResource Section}"/>
                <TextBlock Text="Layout" Margin="0,0,0,8"/>
                <WrapPanel x:Name="LayoutOptions">
                    <RadioButton Content="Compact" GroupName="Layout" Tag="Kompak" Checked="LayoutChanged"/>
                    <RadioButton Content="Card" GroupName="Layout" Tag="Kad" Checked="LayoutChanged"/>
                    <RadioButton Content="Detailed" GroupName="Layout" Tag="Terperinci" Checked="LayoutChanged"/>
                </WrapPanel>
                <TextBlock Text="Theme" Margin="0,10,0,8"/>
                <WrapPanel>
                    <RadioButton x:Name="DarkTheme" Content="Black" GroupName="Theme" Checked="ThemeChanged"/>
                    <RadioButton x:Name="LightTheme" Content="White" GroupName="Theme" Checked="ThemeChanged"/>
                </WrapPanel>
                <Grid Margin="0,12,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Resting opacity"/>
                    <TextBlock x:Name="OpacityValue" Grid.Column="1" FontWeight="SemiBold"/>
                </Grid>
                <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" ValueChanged="OpacityChanged" AutomationProperties.Name="Resting opacity percentage"/>
                <TextBlock Text="Expanded dock stays fully opaque for reading." Style="{StaticResource Hint}"/>

                <Border Height="1" Background="{DynamicResource Line}" Margin="0,22,0,20"/>
                <TextBlock Text="Windows &amp; updates" Style="{StaticResource Section}"/>
                <CheckBox x:Name="StartupToggle" Content="Run at Windows login" Click="StartupChanged"/>
                <TextBlock Text="Open the widget and check for updates when you sign in." Style="{StaticResource Hint}" Margin="28,2,0,14"/>
                <WrapPanel VerticalAlignment="Center">
                    <Button x:Name="UpdateButton" Click="UpdateClicked"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </WrapPanel>
                <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite"/>

                <Border Height="1" Background="{DynamicResource Line}" Margin="0,22,0,20"/>
                <TextBlock Text="Account" Style="{StaticResource Section}"/>
                <TextBlock x:Name="AccountText" Margin="0,0,0,12"/>
                <WrapPanel>
                    <Button x:Name="SignOutButton" Content="Sign out" Click="SignOutClicked" Margin="0,0,8,0"/>
                    <Button Content="Exit app" Click="ExitClicked"/>
                </WrapPanel>
                <TextBlock x:Name="AccountStatus" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveStatus" Text="Changes saved automatically" Style="{StaticResource Hint}" Margin="0,0,16,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                <Button Grid.Column="1" Content="Done" IsCancel="True" Click="DoneClicked" Background="{DynamicResource Ink}" Foreground="{DynamicResource Surface}" BorderBrush="{DynamicResource Ink}" MinWidth="80"/>
            </Grid>
        </Border>
    </Grid>
</Window>
